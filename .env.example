# NEXT_PUBLIC_SITE_URL: Canonical public URL (optional).
# On Vercel, metadata uses VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=""

# ==============================================================================
# Firebase 設定（Firebase Console -> 專案設定 -> 一般 -> 您的應用程式）
# 填入並於 /admin 匯入論文後，官網將自動改讀 Firebase Firestore（1 次讀取快取）
# 未填寫前會自動沿用 B 站 GitHub Pages papers.json 作為備援
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# 允許登入 /admin 並觸發即時發布的管理者 Google 信箱（多個請用逗號分隔）
# 注意：請同步把相同信箱名單填進 firestore.rules 與 storage.rules
ADMIN_EMAILS="yrma@gm.fgu.edu.tw"
NEXT_PUBLIC_ADMIN_EMAILS="yrma@gm.fgu.edu.tw"
